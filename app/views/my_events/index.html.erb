<% content_for :title, "My events — eventa" %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 py-10">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">My events</h1>

  <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Organizing</h2>
  <% if @organized.any? %>
    <div class="space-y-2 mb-8">
      <% @organized.each do |event| %>
        <div class="flex items-center justify-between rounded-lg border border-gray-200 bg-white px-4 py-3">
          <div>
            <%= link_to event.name, event, class: "font-medium text-gray-900 hover:text-orange-600" %>
            <p class="text-xs text-gray-400"><%= event.started_at.strftime("%b %-d, %Y") %></p>
          </div>
          <%= link_to "Manage team", event_team_members_path(event), class: "text-sm text-orange-600 hover:text-orange-700" %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-400 text-sm mb-8">You're not organizing any events yet.</p>
  <% end %>

  <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Volunteering</h2>
  <% if @volunteering.any? %>
    <div class="space-y-2">
      <% @volunteering.each do |event| %>
        <div class="rounded-lg border border-gray-200 bg-white px-4 py-3">
          <%= link_to event.name, event, class: "font-medium text-gray-900 hover:text-orange-600" %>
          <p class="text-xs text-gray-400"><%= event.started_at.strftime("%b %-d, %Y") %></p>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-400 text-sm">You're not volunteering for any events yet.</p>
  <% end %>
</div>
