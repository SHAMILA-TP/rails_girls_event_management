<% if event.errors.any? %>
  <div class="mb-6 rounded-lg bg-red-50 text-red-700 text-sm px-4 py-3">
    <ul class="list-disc list-inside">
      <% event.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: event, class: "space-y-4" do |form| %>
  <div>
    <%= form.label :title, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :title, required: true, autofocus: true, placeholder: "Sunrise Yoga in the Park", class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500" %>
  </div>

  <div>
    <%= form.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_area :description, rows: 4, placeholder: "What should attendees know about this event?", class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500" %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= form.label :location, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :location, required: true, placeholder: "Portland, OR", class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500" %>
    </div>
    <div>
      <%= form.label :category, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :category, placeholder: "Workshop, Music, Tech...", class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500" %>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= form.label :starts_at, "Date & time", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.datetime_field :starts_at, required: true, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500" %>
    </div>
    <div>
      <%= form.label :price, "Price (USD, 0 for free)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.number_field :price, step: "0.01", min: 0, placeholder: "0", class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500" %>
    </div>
  </div>

  <div>
    <%= form.label :image_url, "Image URL", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :image_url, placeholder: "https://...", class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500" %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= form.submit (event.persisted? ? "Save changes" : "Create event"), class: "rounded-lg bg-orange-600 text-white font-semibold px-5 py-2 text-sm hover:bg-orange-700 cursor-pointer" %>
    <%= link_to "Cancel", event.persisted? ? event : events_path, class: "text-sm text-gray-500 hover:text-gray-900" %>
  </div>
<% end %>
