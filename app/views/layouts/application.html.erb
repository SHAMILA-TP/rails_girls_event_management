<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Rails Girls Event Management" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <script src="https://cdn.tailwindcss.com"></script>
  </head>

  <body class="bg-gray-50 text-gray-900">
    <header class="bg-white border-b border-gray-200 sticky top-0 z-10">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
        <%= link_to root_path, class: "flex items-center gap-2" do %>
          <span class="text-2xl font-extrabold tracking-tight text-orange-600">eventa</span>
        <% end %>
        <nav class="flex items-center gap-4 sm:gap-6 text-sm font-medium text-gray-600">
          <%= link_to "Browse events", events_path, class: "hover:text-gray-900" %>

          <% if user_signed_in? %>
            <%= link_to "Create event", new_event_path, class: "rounded-full bg-orange-600 text-white px-4 py-2 hover:bg-orange-700" %>
            <%= link_to current_user.name, edit_user_registration_path, class: "text-gray-400 hidden sm:inline hover:text-gray-900" %>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "bg-transparent border-0 p-0 text-gray-600 hover:text-gray-900 cursor-pointer font-medium" %>
          <% else %>
            <%= link_to "Sign in", new_user_session_path, class: "hover:text-gray-900" %>
            <%= link_to "Sign up", new_user_registration_path, class: "rounded-full bg-orange-600 text-white px-4 py-2 hover:bg-orange-700" %>
          <% end %>
        </nav>
      </div>
    </header>

    <% if flash[:notice] || flash[:alert] %>
      <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-4">
        <% if flash[:notice] %>
          <div class="rounded-lg bg-green-50 text-green-700 text-sm px-4 py-3"><%= flash[:notice] %></div>
        <% end %>
        <% if flash[:alert] %>
          <div class="rounded-lg bg-red-50 text-red-700 text-sm px-4 py-3"><%= flash[:alert] %></div>
        <% end %>
      </div>
    <% end %>

    <main>
      <%= yield %>
    </main>

    <footer class="border-t border-gray-200 mt-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 text-sm text-gray-400">
        &copy; <%= Date.current.year %> eventa &mdash; built with Rails for Rails Girls.
      </div>
    </footer>
  </body>
</html>
