<% content_for :title, "Sign up — eventa" %>

<div class="max-w-sm mx-auto px-4 py-16">
  <h1 class="text-2xl font-bold text-gray-900 text-center">Create your account</h1>

  <% if @user.errors.any? %>
    <div class="mt-4 rounded-lg bg-red-50 text-red-700 text-sm px-4 py-3">
      <ul class="list-disc list-inside">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: registration_path, class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :name, required: true, autofocus: true, placeholder: "Jane Doe", class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500" %>
    </div>
    <div>
      <%= form.label :email_address, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.email_field :email_address, required: true, autocomplete: "username", placeholder: "you@example.com", class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500" %>
    </div>
    <div>
      <%= form.label :password, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "••••••••", maxlength: 72, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500" %>
    </div>
    <div>
      <%= form.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "••••••••", maxlength: 72, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500" %>
    </div>

    <div>
      <span class="block text-sm font-medium text-gray-700 mb-2">I'm signing up as a...</span>
      <div class="grid grid-cols-2 gap-3">
        <label class="flex items-center justify-center gap-2 rounded-lg border border-gray-300 px-3 py-2 text-sm cursor-pointer has-[:checked]:border-orange-600 has-[:checked]:bg-orange-50 has-[:checked]:text-orange-700">
          <%= form.radio_button :role, "attendee", checked: true, class: "sr-only" %>
          Attendee
        </label>
        <label class="flex items-center justify-center gap-2 rounded-lg border border-gray-300 px-3 py-2 text-sm cursor-pointer has-[:checked]:border-orange-600 has-[:checked]:bg-orange-50 has-[:checked]:text-orange-700">
          <%= form.radio_button :role, "organizer", class: "sr-only" %>
          Organizer
        </label>
      </div>
    </div>

    <%= form.submit "Sign up", class: "w-full rounded-lg bg-orange-600 text-white font-semibold py-2 text-sm hover:bg-orange-700 cursor-pointer" %>
  <% end %>

  <p class="mt-4 text-center text-sm text-gray-500">
    Already have an account?
    <%= link_to "Sign in", new_session_path, class: "text-orange-600 font-medium hover:text-orange-700" %>
  </p>
</div>
