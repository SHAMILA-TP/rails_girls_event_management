<% content_for :title, "Sign in — eventa" %>

<div class="max-w-sm mx-auto px-4 py-16">
  <h1 class="text-2xl font-bold text-gray-900 text-center">Sign in</h1>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-6 space-y-4" }) do |f| %>
    <div>
      <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com", class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500" %>
    </div>
    <div>
      <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password, autocomplete: "current-password", placeholder: "••••••••", class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <label class="flex items-center gap-2 text-sm text-gray-600">
        <%= f.check_box :remember_me, class: "rounded border-gray-300 text-orange-600 focus:ring-orange-500" %>
        <%= f.label :remember_me, "Remember me", class: "mb-0" %>
      </label>
    <% end %>

    <%= f.submit "Sign in", class: "w-full rounded-lg bg-orange-600 text-white font-semibold py-2 text-sm hover:bg-orange-700 cursor-pointer" %>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
