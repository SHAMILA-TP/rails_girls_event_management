<% content_for :title, "eventa — Find your next event" %>

<section class="bg-gradient-to-br from-orange-500 to-pink-600 text-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16 text-center">
    <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight">Discover events you'll love</h1>
    <p class="mt-4 text-lg text-orange-50 max-w-xl mx-auto">
      Workshops, concerts, meetups, and more — find something happening near you.
    </p>
  </div>
</section>

<section class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
  <%= form_with url: events_path, method: :get, class: "flex flex-wrap items-end gap-3 mb-8" do %>
    <div class="flex-1 min-w-[180px]">
      <label class="block text-xs font-medium text-gray-500 mb-1">Search</label>
      <input type="text" name="q" value="<%= params[:q] %>" placeholder="Name, description, location…" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500">
    </div>

    <div>
      <label class="block text-xs font-medium text-gray-500 mb-1">Category</label>
      <select name="category" class="rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500">
        <option value="">All</option>
        <% @categories.each do |cat| %>
          <option value="<%= cat %>" <%= "selected" if params[:category] == cat %>><%= cat %></option>
        <% end %>
      </select>
    </div>

    <div>
      <label class="block text-xs font-medium text-gray-500 mb-1">Price</label>
      <select name="price" class="rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500">
        <option value="">Any</option>
        <option value="free" <%= "selected" if params[:price] == "free" %>>Free</option>
        <option value="paid" <%= "selected" if params[:price] == "paid" %>>Paid</option>
      </select>
    </div>

    <label class="flex items-center gap-2 text-sm text-gray-600 pb-2">
      <input type="checkbox" name="show_past" value="1" <%= "checked" if params[:show_past] == "1" %> class="rounded border-gray-300 text-orange-600 focus:ring-orange-500">
      Include past events
    </label>

    <button type="submit" class="rounded-lg bg-orange-600 text-white font-semibold px-5 py-2 text-sm hover:bg-orange-700 cursor-pointer">Filter</button>
    <% if params[:q].present? || params[:category].present? || params[:price].present? || params[:show_past].present? %>
      <%= link_to "Clear", events_path, class: "text-sm text-gray-500 hover:text-gray-900 pb-2" %>
    <% end %>
  <% end %>

  <h2 class="text-xl font-bold mb-6"><%= pluralize(@events.size, "event") %> found</h2>

  <% if @events.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @events.each do |event| %>
        <%= link_to event_path(event), class: "group block rounded-xl overflow-hidden border border-gray-200 bg-white hover:shadow-lg transition-shadow" do %>
          <div class="aspect-[16/9] bg-gray-100 overflow-hidden">
            <img src="<%= event.image_url %>" alt="<%= event.name %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
          </div>
          <div class="p-4">
            <div class="flex items-center justify-between text-xs font-semibold text-orange-600 uppercase tracking-wide">
              <span><%= event.category %></span>
              <span><%= event.free? ? "Free" : "$#{'%.0f' % event.price}" %></span>
            </div>
            <h3 class="mt-2 font-bold text-gray-900 leading-snug"><%= event.name %></h3>
            <p class="mt-1 text-sm text-gray-500"><%= event.started_at.strftime("%a, %b %-d · %-l:%M %p") %></p>
            <p class="mt-1 text-sm text-gray-400"><%= event.location %></p>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-400">No events match your filters.</p>
  <% end %>
</section>
