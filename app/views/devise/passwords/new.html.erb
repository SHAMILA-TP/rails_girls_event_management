<% content_for :title, "Forgot password — eventa" %>

<div class="max-w-sm mx-auto px-4 py-16">
  <h1 class="text-2xl font-bold text-gray-900 text-center">Forgot your password?</h1>
  <p class="mt-2 text-sm text-gray-500 text-center">We'll send reset instructions to your email.</p>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "mt-6 space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com", class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500" %>
    </div>

    <%= f.submit "Email reset instructions", class: "w-full rounded-lg bg-orange-600 text-white font-semibold py-2 text-sm hover:bg-orange-700 cursor-pointer" %>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
