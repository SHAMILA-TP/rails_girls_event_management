<div class="mt-4 flex items-center justify-between text-sm">
  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <%= link_to "Forgot password?", new_password_path(resource_name), class: "text-gray-500 hover:text-gray-900" %>
  <% else %>
    <span></span>
  <% end %>

  <%- if controller_name != 'sessions' %>
    <%= link_to "Sign in", new_session_path(resource_name), class: "text-orange-600 font-medium hover:text-orange-700" %>
  <% elsif devise_mapping.registerable? %>
    <%= link_to "Create an account", new_registration_path(resource_name), class: "text-orange-600 font-medium hover:text-orange-700" %>
  <% end %>
</div>
